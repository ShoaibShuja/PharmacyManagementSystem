# Required public Supabase configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy alternative. Use this only if the Supabase project still provides an
# anon key instead of a publishable key. Do not configure both.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# No application URL or service-role key is required by the current app.
